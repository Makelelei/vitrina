# Copiá este archivo como .env y completá los valores antes de "npm run build".

# Endpoint PHP que recibe las solicitudes (server/public/api/lead.php subido a tu Hostinger).
# Vacío = modo demo: las solicitudes quedan solo en el navegador.
VITE_LEAD_ENDPOINT=

# WhatsApp de ventas de Vitrina, con código de país y sin espacios (ej: 5491122334455).
# Se usa para que el cliente coordine el pago con vos después de enviar la solicitud.
VITE_OWNER_WHATSAPP=

# Dominio de Vitrina donde se publican los sitios de clientes como subdominios
# (ej: vitrinastudio.online → fuego-burgers.vitrinastudio.online).
VITE_SITES_DOMAIN=
